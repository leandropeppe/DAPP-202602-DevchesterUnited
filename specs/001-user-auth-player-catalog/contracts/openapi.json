{
  "openapi": "3.0.3",
  "info": {
    "title": "Devchester United — Autenticación y catálogo",
    "version": "1.0.0",
    "description": "Contrato de la Entrega 1. Mensajes en español. Registro/login públicos, JWT para generar API Key y X-API-KEY para consultar catálogo. Swagger solo habilitado en perfiles local/test."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Entorno local"
    }
  ],
  "tags": [
    {
      "name": "Autenticación",
      "description": "Registro, login y credenciales."
    },
    {
      "name": "Catálogo",
      "description": "Consulta de jugadores."
    }
  ],
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "operationId": "registrarUsuario",
        "tags": [
          "Autenticación"
        ],
        "summary": "Registrar un usuario",
        "description": "Username y email únicos sin distinguir mayúsculas; formato y mensajes en español. Rechazar JSON desconocido o inválido.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistroRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario creado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistroResponse"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "El nombre de usuario o el correo electrónico ya está registrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Fallo interno; mensaje genérico en español.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Base de datos no disponible; no se concede acceso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "iniciarSesion",
        "tags": [
          "Autenticación"
        ],
        "summary": "Autenticar usuario y emitir JWT",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autenticación exitosa.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "Evita almacenamiento de credenciales.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Nombre de usuario o contraseña incorrectos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Fallo interno; mensaje genérico en español.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Base de datos no disponible; no se concede acceso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/apikey": {
      "post": {
        "operationId": "generarApiKey",
        "tags": [
          "Autenticación"
        ],
        "summary": "Generar o rotar API Key",
        "description": "Sin cuerpo. Requiere JWT válido y usuario existente. Sin vencimiento automático. Una transacción crea la nueva clave y revoca la anterior. Competencia por el bloqueo de rotación del mismo usuario devuelve 409 sin cambios ni reintentos automáticos; una operación posterior al commit es una nueva rotación. El secreto se devuelve solo después del commit y no se puede recuperar.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Clave generada; guardar el secreto.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKeyResponse"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "Evita almacenamiento de credenciales.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida, incluido cuerpo no vacío.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No autorizado: JWT ausente, inválido o expirado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Otra solicitud está generando una API Key para este usuario.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Fallo interno; mensaje genérico en español.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Base de datos no disponible; no se concede acceso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/players": {
      "get": {
        "operationId": "consultarJugadores",
        "tags": [
          "Catálogo"
        ],
        "summary": "Consultar catálogo con filtros parciales",
        "description": "API Key activa validada al inicio contra estado confirmado; consultas ya autorizadas pueden terminar después de revocación. Filtros literales parciales sin distinguir mayúsculas, con AND; tildes significativas. Trim antes de validar, vacíos/controles/repetidos/desconocidos devuelven 400. % y _ son texto literal. Orden estable por UUID ascendente. Página fuera de rango devuelve lista vacía con totales reales; cero coincidencias implica total_pages=0. Offset fuera del rango soportado devuelve 400.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "league",
            "in": "query",
            "required": false,
            "description": "Subcadena literal sin distinguir mayúsculas. ",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          {
            "name": "team",
            "in": "query",
            "required": false,
            "description": "Subcadena literal sin distinguir mayúsculas. Madrid encuentra Real Madrid y Atlético de Madrid.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          {
            "name": "position",
            "in": "query",
            "required": false,
            "description": "Subcadena literal sin distinguir mayúsculas. ",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Página desde 1.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 2147483647,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Cantidad máxima por página.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Jugadores y metadatos de paginación.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JugadoresResponse"
                }
              }
            }
          },
          "400": {
            "description": "Parámetros de consulta inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No autorizado: API Key inválida, revocada o ausente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Fallo interno; mensaje genérico en español.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Base de datos no disponible; no se concede acceso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT HS256 de duración 3600 segundos."
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-KEY",
        "description": "API Key activa sin vencimiento automático."
      }
    },
    "schemas": {
      "RegistroRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "email",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30,
            "pattern": "^[A-Za-z0-9]+$",
            "description": "Se recortan espacios externos y se normaliza a minúsculas antes de validar y comparar."
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "Trim y minúsculas antes de validar; único."
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "minLength": 8,
            "maxLength": 72,
            "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])\\S(?:.*\\S)?$",
            "description": "Máximo adicional de 72 bytes UTF-8, sin caracteres de control ni espacios externos; nunca truncar."
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30,
            "pattern": "^[A-Za-z0-9]+$",
            "description": "Se recortan espacios externos y se normaliza a minúsculas antes de validar y comparar."
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "minLength": 1,
            "maxLength": 72,
            "description": "Máximo 72 bytes UTF-8; no transformar. Una contraseña estructuralmente válida pero incorrecta devuelve 401."
          }
        }
      },
      "Usuario": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "username",
          "email",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^usr_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "username": {
            "type": "string",
            "pattern": "^[a-z0-9]{3,30}$"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RegistroResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "message",
          "data"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ]
          },
          "message": {
            "type": "string",
            "example": "Usuario registrado correctamente"
          },
          "data": {
            "$ref": "#/components/schemas/Usuario"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "message",
          "data"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ]
          },
          "message": {
            "type": "string",
            "example": "Autenticación exitosa"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "token_type",
              "access_token",
              "expires_in"
            ],
            "properties": {
              "token_type": {
                "type": "string",
                "enum": [
                  "Bearer"
                ]
              },
              "access_token": {
                "type": "string",
                "description": "JWT HS256 firmado; iss=devchester-united, aud=devchester-api, sub=usr_<uuid>, iat y exp."
              },
              "expires_in": {
                "type": "integer",
                "enum": [
                  3600
                ]
              }
            }
          }
        }
      },
      "ApiKeyResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "message",
          "data"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ]
          },
          "message": {
            "type": "string",
            "example": "API Key generada correctamente. Guardá esta clave; no se volverá a mostrar."
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "api_key",
              "prefix",
              "is_active",
              "created_at"
            ],
            "properties": {
              "api_key": {
                "type": "string",
                "pattern": "^dev_key_[A-Za-z0-9_-]{43}$",
                "description": "Secreto visible solo en esta respuesta; sin vencimiento automático."
              },
              "prefix": {
                "type": "string",
                "minLength": 14,
                "maxLength": 14
              },
              "is_active": {
                "type": "boolean",
                "enum": [
                  true
                ]
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "Jugador": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "first_name",
          "last_name",
          "league",
          "team",
          "position",
          "jersey_number",
          "nationality"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ply_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "first_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "last_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "league": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "team": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "position": {
            "type": "string",
            "enum": [
              "Forward",
              "Midfielder",
              "Defender",
              "Goalkeeper"
            ]
          },
          "jersey_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "nationality": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "Paginacion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "current_page",
          "page_size",
          "total_pages",
          "total_records"
        ],
        "properties": {
          "current_page": {
            "type": "integer",
            "minimum": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total_pages": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "total_records": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "JugadoresResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "data"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ]
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "players",
              "pagination"
            ],
            "properties": {
              "players": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Jugador"
                }
              },
              "pagination": {
                "$ref": "#/components/schemas/Paginacion"
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "message": {
            "type": "string",
            "description": "Mensaje en español sin secretos ni detalles internos."
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "issue"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "issue": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
